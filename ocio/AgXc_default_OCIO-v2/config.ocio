# version: 1.0.0
# name: AgXc
# variant: default_OCIO-v2
# built on: 2024-06-22 21:50:09.275093
# // visit https://github.com/MrLixm/AgXc
# // and inspect the python build script for details

ocio_profile_version: 2

environment:
  {}
search_path: LUTs
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: AgXc
description: |
  AgX image rendering initially designed by Troy Sobotka.
  Adapted by Liam Collod with full permissions from Troy Sobotka.
  C.A.T. used for whitepoint conversions is <Bradford>.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: sRGB-2.2
  color_timing: sRGB-2.2
  compositing_log: AgXc-Log
  data: Passthrough
  default: sRGB-2.2
  default_byte: sRGB-2.2
  default_float: sRGB-linear
  default_sequencer: sRGB-2.2
  matte_paint: sRGB-2.2
  reference: BT.2020-linear
  scene_linear: BT.2020-linear
  texture_paint: sRGB-2.2

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  sRGB-2.2:
    - !<View> {name: AgXc, colorspace: Image AgXc sRGB-2.2}
    - !<View> {name: AgXc Punchy, colorspace: Image AgXc-Punchy sRGB-2.2}
    - !<View> {name: Disabled, colorspace: Passthrough}
    - !<View> {name: Display Native, colorspace: sRGB-2.2}
  sRGB-EOTF:
    - !<View> {name: AgXc, colorspace: Image AgXc sRGB-EOTF}
    - !<View> {name: AgXc Punchy, colorspace: Image AgXc-Punchy sRGB-EOTF}
    - !<View> {name: Disabled, colorspace: Passthrough}
    - !<View> {name: Display Native, colorspace: sRGB-EOTF}
  Display-P3:
    - !<View> {name: AgXc, colorspace: Image AgXc Display-P3}
    - !<View> {name: AgXc Punchy, colorspace: Image AgXc-Punchy Display-P3}
    - !<View> {name: Disabled, colorspace: Passthrough}
    - !<View> {name: Display Native, colorspace: Display-P3}
  BT.1886:
    - !<View> {name: AgXc, colorspace: Image AgXc BT.1886}
    - !<View> {name: AgXc Punchy, colorspace: Image AgXc-Punchy BT.1886}
    - !<View> {name: Disabled, colorspace: Passthrough}
    - !<View> {name: Display Native, colorspace: BT.1886}
  Pre-Display:
    - !<View> {name: AgX, colorspace: AgXc}

active_displays: []
active_views: []

looks:
  - !<Look>
    name: Punchy
    process_space: AgXc
    description: A punchy and more chroma laden look.
    transform: !<CDLTransform> {power: [1.3, 1.3, 1.3], sat: 1.2}


colorspaces:
  - !<ColorSpace>
    name: 2.2-EOTF-Encoding
    family: Utilities/Curves
    equalitygroup: ""
    bitdepth: unknown
    description: "transfer-function: 2.2 Exponent EOTF Encoding"
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: 2.4-EOTF-Encoding
    family: Utilities/Curves
    equalitygroup: ""
    bitdepth: unknown
    description: "transfer-function: 2.4 Exponent EOTF Encoding"
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.4, direction: inverse}

  - !<ColorSpace>
    name: sRGB-2.2
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: sRGB with transfer-function simplified to the 2.2 power function.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: sRGB-EOTF
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: |
      sRGB IEC 61966-2-1 2.2 Exponent Reference EOTF Display
      This "colorspace" is required by Redshift.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<FileTransform> {src: sRGB-EOTF-inverse.spi1d, interpolation: linear}

  - !<ColorSpace>
    name: Display-P3
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: Display P3 2.2 Exponent EOTF Display. For Apple hardware.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [1.426166505272, -0.364612268752, -0.061554236519, 0, -0.062506241812, 1.068971722372, -0.00646548056, 0, 0.002443822655, -0.021121296942, 1.018677474287, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: BT.1886
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: BT.1886 2.4 Exponent EOTF Display. Also known as Rec.709 transfer function.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.4, direction: inverse}

  - !<ColorSpace>
    name: AgXc-Log
    family: AgX
    equalitygroup: ""
    bitdepth: 32f
    description: AgX Log encoding.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<RangeTransform> {min_in_value: 0, min_out_value: 0}
        - !<AllocationTransform> {allocation: lg2, vars: [-12.47393, 4.026069]}

  - !<ColorSpace>
    name: AgXc
    family: AgX
    equalitygroup: ""
    bitdepth: unknown
    description: |
      AgXc image rendering transform.
      Output is encoded in working colorspace.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.472738636743224, 0.12687790806726, 0.400383455189515, 0, 0.186381444574505, 0.589240731652576, 0.224377823772918, 0, 0.134783472151827, 0.166178005290661, 0.699038522557512, 0, 0, 0, 0, 1]}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15]}
        - !<FileTransform> {src: luminance-compensation.cube, interpolation: linear}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15], direction: inverse}
        - !<MatrixTransform> {matrix: [0.618670147202678, 0.234793838818814, 0.146536013978508, 0, 0.286893546584074, 0.403294772093313, 0.309811681322613, 0, 0.18487431590798, 0.0656521026537463, 0.749473581438274, 0, 0, 0, 0, 1]}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc-Log}
        - !<FileTransform> {src: AgX_Default_Contrast.spi1d, interpolation: linear}
        - !<MatrixTransform> {matrix: [1.70401243235717, -0.279876242822721, -0.424136189534447, 0, -0.549691197050973, 1.97382738658542, -0.424136189534448, 0, -0.549691197050973, -0.279876242822721, 1.82956743987369, 0, 0, 0, 0, 1]}
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<ColorSpaceTransform> {src: 2.4-EOTF-Encoding, dst: reference}

  - !<ColorSpace>
    name: AgXc-Tonescale
    family: AgX
    equalitygroup: ""
    bitdepth: unknown
    description: AgXc 1D curve. Output is linear.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc-Log}
        - !<FileTransform> {src: AgX_Default_Contrast.spi1d, interpolation: linear}
        - !<ColorSpaceTransform> {src: 2.4-EOTF-Encoding, dst: reference}

  - !<ColorSpace>
    name: Passthrough
    family: Colorspaces
    equalitygroup: scalar
    bitdepth: 32f
    description: Passthrough means no transformations. Also know as "raw".
    isdata: true
    allocation: uniform

  - !<ColorSpace>
    name: sRGB-linear
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: Open Domain Linear BT.709 Tristimulus
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACEScg
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: ACES rendering space for CGI. Also known as AP1.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.974894977924, 0.019599108637, 0.005505913439, 0, 0.002179562798, 0.995535468893, 0.002284968309, 0, 0.004797239684, 0.024532016635, 0.970670743682, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACES2065-1
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: ACES Interchange format. Also known as AP0.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.679085634707, 0.157700914643, 0.16321345065, 0, 0.04600200308, 0.859054673003, 0.094943323917, 0, -0.000573943188, 0.028467768408, 0.97210617478, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: CIE-XYZ-D65
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: CIE 1931 Colorspace with a D65 whitepoint.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.636958048301, 0.144616903586, 0.168880975164, 0, 0.262700212011, 0.677998071519, 0.05930171647, 0, 0, 0.028072693049, 1.060985057711, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: BT.2020-linear
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: |
      The ITU-R BT.2020 colorspace with a linear transfer-function.
      A very wide gamut on the edge of the spectral locus, with a D65 whitepoint.
      Also the reference/working colorspace for this config.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {}

  - !<ColorSpace>
    name: Image AgXc sRGB-2.2
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - a conversion for sRGB-2.2 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<ColorSpaceTransform> {src: reference, dst: sRGB-2.2}

  - !<ColorSpace>
    name: Image AgXc sRGB-EOTF
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - a conversion for sRGB-EOTF display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<ColorSpaceTransform> {src: reference, dst: sRGB-EOTF}

  - !<ColorSpace>
    name: Image AgXc Display-P3
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - a conversion for Display-P3 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<ColorSpaceTransform> {src: reference, dst: Display-P3}

  - !<ColorSpace>
    name: Image AgXc BT.1886
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - a conversion for BT.1886 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<ColorSpaceTransform> {src: reference, dst: BT.1886}

  - !<ColorSpace>
    name: Image AgXc-Punchy sRGB-2.2
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - the Punchy look transform
      - a conversion for sRGB-2.2 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<LookTransform> {src: AgXc, dst: AgXc, looks: Punchy}
        - !<ColorSpaceTransform> {src: reference, dst: sRGB-2.2}

  - !<ColorSpace>
    name: Image AgXc-Punchy sRGB-EOTF
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - the Punchy look transform
      - a conversion for sRGB-EOTF display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<LookTransform> {src: AgXc, dst: AgXc, looks: Punchy}
        - !<ColorSpaceTransform> {src: reference, dst: sRGB-EOTF}

  - !<ColorSpace>
    name: Image AgXc-Punchy Display-P3
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - the Punchy look transform
      - a conversion for Display-P3 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<LookTransform> {src: AgXc, dst: AgXc, looks: Punchy}
        - !<ColorSpaceTransform> {src: reference, dst: Display-P3}

  - !<ColorSpace>
    name: Image AgXc-Punchy BT.1886
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc image rendering transform
      - the Punchy look transform
      - a conversion for BT.1886 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc}
        - !<LookTransform> {src: AgXc, dst: AgXc, looks: Punchy}
        - !<ColorSpaceTransform> {src: reference, dst: BT.1886}
